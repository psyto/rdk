{
  "_comment": [
    "Reference faucet config for the v0 public testnet. Copy this",
    "to your deployment-specific path (e.g. /etc/princeps-faucet/config.json),",
    "chmod 0640, and pass via `princeps-faucet serve --config <path>`.",
    "",
    "T4a-1 fields:",
    "  listen_addr  — HTTP API bind. Put TLS termination upstream.",
    "  metrics_bind — optional Prometheus scrape endpoint. TD-006",
    "                 requires this to be a different port from",
    "                 listen_addr so internal scraping never shares",
    "                 a surface with public traffic.",
    "  chain_id     — the chain this faucet drips against. Must",
    "                 match testnet-genesis.json.",
    "",
    "T4a-2 fields:",
    "  rate_limit     — three-dimensional check (per-IP, per-",
    "                   recipient, global) applied on every drip.",
    "                   Defaults below match RateLimitConfig::",
    "                   testnet_defaults: one drip per IP and per",
    "                   recipient per 24h; 100 drips/hour global",
    "                   ceiling for wallet-drain protection. Adjust",
    "                   based on observed traffic.",
    "  state_db_path  — SQLite file backing the rate-limit table.",
    "                   Put it on durable storage so rate-limit",
    "                   state survives faucet restart. Parent dir",
    "                   is auto-created on first boot.",
    "",
    "T4a-3 fields:",
    "  drip           — per-drip payout in u128 base units, JSON-",
    "                   encoded as STRINGS (eth-wei overflows the",
    "                   JSON-number 2^53 precision range). Defaults:",
    "                   0.1 ETH + 10000 USDC. T4a-3 stubs the chain",
    "                   submission so a drip request returns 200 +",
    "                   an all-zero tx_hash; T4a-5 replaces the stub",
    "                   with a real alloy broadcast.",
    "",
    "T4a-4 fields:",
    "  captcha        — externally-tagged enum. `{ provider:",
    "                   \"disabled\" }` skips verification (local-",
    "                   dev ONLY — production MUST switch to",
    "                   hcaptcha). `{ provider: \"hcaptcha\",",
    "                   secret: \"...\" [, site_key: \"...\"] }`",
    "                   calls https://api.hcaptcha.com/siteverify.",
    "                   `secret` is sensitive; chmod the config",
    "                   0o640. `site_key` is read by the browser",
    "                   widget, NOT by the faucet — documented",
    "                   here so the deployment runbook has it in",
    "                   one place.",
    "",
    "T4a-5 fields:",
    "  chain          — { rpc_url, wallet_keystore_path }. rpc_url",
    "                   is the JSON-RPC endpoint the faucet posts",
    "                   eth_sendRawTransaction to (typically a",
    "                   read-only `princeps-lending-rpc-server`",
    "                   follower per TD-004, or a validator RPC).",
    "                   wallet_keystore_path is an Ethereum Web3 V3",
    "                   keystore — mint with `cast wallet new",
    "                   --password ...` or geth's `account new`.",
    "                   At boot, --wallet-keystore-passphrase-file",
    "                   <path> OR --wallet-keystore-passphrase-stdin",
    "                   is REQUIRED; the faucet refuses to start",
    "                   without one of them.",
    "",
    "                   USDC is OUT OF SCOPE at T4a-5: USDC on",
    "                   this chain is bridge-side accounting",
    "                   indexed by AccountId(u64), not an ERC-20",
    "                   address. Until the address-to-AccountId",
    "                   convention is settled at the system level",
    "                   the faucet ships ETH-only and the",
    "                   drip.usdc_amount_base_units is informational",
    "                   only (the field round-trips through the API",
    "                   but no USDC is actually credited)."
  ],
  "listen_addr": "127.0.0.1:8080",
  "metrics_bind": "127.0.0.1:9091",
  "chain_id": 424242,
  "rate_limit": {
    "per_ip_window_secs": 86400,
    "per_ip_max_drips": 1,
    "per_recipient_window_secs": 86400,
    "per_recipient_max_drips": 1,
    "global_window_secs": 3600,
    "global_max_drips": 100
  },
  "state_db_path": "/var/lib/princeps-faucet/state.db",
  "drip": {
    "eth_amount_wei": "100000000000000000",
    "usdc_amount_base_units": "10000000000"
  },
  "captcha": {
    "provider": "disabled"
  },
  "chain": {
    "rpc_url": "http://127.0.0.1:8545",
    "wallet_keystore_path": "/etc/princeps-faucet/wallet-keystore.json"
  }
}
